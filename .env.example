# OPENAI_API_KEY: Required for YourNeed AI Assistant (server-side only).
# AI Studio injects secrets from Settings > Secrets at runtime, or set in local .env.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# OPENAI_MODEL: Optional OpenAI model ID for the Responses API (defaults to gpt-4.1-mini).
OPENAI_MODEL="gpt-4.1-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
